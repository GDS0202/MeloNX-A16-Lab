<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <SchedulerUnderTest Condition="'$(SchedulerUnderTest)' == ''">../../src/Ryujinx.Graphics.Vulkan/BackgroundCompilationScheduler.cs</SchedulerUnderTest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ryujinx.Common/Ryujinx.Common.csproj" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <Compile Include="$(SchedulerUnderTest)" Link="BackgroundCompilationScheduler.cs" />
    <Compile Include="../../src/Ryujinx.Graphics.Vulkan/FrameTimeMetrics.cs" Link="FrameTimeMetrics.cs" />
  </ItemGroup>
</Project>
